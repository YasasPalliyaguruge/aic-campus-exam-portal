rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasStaffClaim() {
      return isAuthenticated()
        && request.auth.token.role in ['ADMIN', 'LECTURER'];
    }

    function hasStaffProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'LECTURER'];
    }

    function isStaff() {
      return hasStaffClaim() || hasStaffProfile();
    }

    function isStudentProfile() {
      return request.resource.data.role == 'STUDENT';
    }

    function ownsSession() {
      return isAuthenticated()
        && resource.data.authUid == request.auth.uid;
    }

    function isOwnFrameUpdate() {
      return ownsSession()
        && resource.data.status == 'IN_PROGRESS'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentFrame', 'currentFramePath', 'currentFrameUpdatedAt'])
        && request.resource.data.currentFrame is string
        && request.resource.data.currentFrame.size() <= 3000
        && request.resource.data.currentFrame.matches('^https://firebasestorage.googleapis.com/.*')
        && request.resource.data.currentFramePath is string
        && request.resource.data.currentFramePath.matches('^proctor-live-frames/[^/]+/[^/]+/current[.]jpg$')
        && request.resource.data.currentFrameUpdatedAt is number;
    }

    function isOwnScreenCaptureUpdate() {
      return ownsSession()
        && resource.data.status == 'IN_PROGRESS'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenCapture'])
        && resource.data.screenCapture is map
        && request.resource.data.screenCapture is map
        && request.resource.data.screenCapture.requestId == resource.data.screenCapture.requestId
        && request.resource.data.screenCapture.keys().hasOnly([
          'requestId',
          'requestedAt',
          'requestedBy',
          'status',
          'imageUrl',
          'storagePath',
          'capturedAt',
          'updatedAt',
          'error',
          'displaySurface'
        ])
        && request.resource.data.screenCapture.status in ['CAPTURING', 'CAPTURED', 'FAILED', 'DENIED', 'STOPPED']
        && request.resource.data.screenCapture.updatedAt is number;
    }

    match /users/{userId} {
      allow read: if isStaff();
      allow create: if isStaff() && isStudentProfile();
      allow update, delete: if isStaff();
    }

    match /programs/{programId} {
      allow read, write: if isStaff();
    }

    match /exams/{examId} {
      allow read, write: if isStaff();
    }

    match /accessCodes/{accessCodeId} {
      allow read, write: if isStaff();
    }

    match /sessions/{sessionId} {
      allow read: if isStaff() || ownsSession();
      allow create: if isStaff();
      allow update: if isStaff() || isOwnFrameUpdate() || isOwnScreenCaptureUpdate();
      allow delete: if isStaff();
    }

    match /_server_time_sync/{docId} {
      allow read, write: if false;
    }
  }
}
