rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated()
        && request.auth.token.role in ['ADMIN', 'LECTURER'];
    }

    function isPdf() {
      return request.resource != null
        && request.resource.contentType == 'application/pdf';
    }

    function isAllowedSubmissionFile() {
      return request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        ];
    }

    function isOwnedSubmissionFile(examId, studentId) {
      return isAuthenticated()
        && resource != null
        && resource.metadata.ownerUid == request.auth.uid
        && resource.metadata.examId == examId
        && resource.metadata.studentId == studentId;
    }

    function isValidSubmissionOwner(examId, studentId) {
      return isAuthenticated()
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.examId == examId
        && request.resource.metadata.studentId == studentId;
    }

    match /exam-resources/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff()
        && isPdf()
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isStaff();
    }

    match /exam-submissions/{examId}/{studentId}/{fileName} {
      allow read: if isStaff() || isOwnedSubmissionFile(examId, studentId);
      allow create: if isAllowedSubmissionFile()
        && isValidSubmissionOwner(examId, studentId);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
